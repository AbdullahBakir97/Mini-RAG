APP_NAME="mini-RAG"
APP_VERSION="0.1"
OPENAI_API_KEY=""
LOG_LEVEL="INFO"

# Embeddings: OpenAI by default. For a local OpenAI-compatible server such as
# Ollama, set EMBEDDING_BASE_URL (e.g. "http://localhost:11434/v1").
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Answer generation: OpenAI by default, using OPENAI_API_KEY. For a local
# OpenAI-compatible server such as Ollama, set LLM_BASE_URL (e.g.
# "http://localhost:11434/v1") and a model it serves. An empty
# LLM_TEMPERATURE uses the model's default.
LLM_BASE_URL=""
LLM_MODEL="gpt-4.1-mini"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=""

# Matches compose.yaml
DATABASE_URL="postgresql+asyncpg://mini_rag:mini_rag@localhost:5432/mini_rag"

FILES_DIR="assets/files"
FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB