APP_NAME="mini-RAG"
APP_VERSION="0.1"
OPENAI_API_KEY=""
LOG_LEVEL="INFO"

# Embeddings: OpenAI by default. For a local OpenAI-compatible server such as
# Ollama, set EMBEDDING_BASE_URL (e.g. "http://localhost:11434/v1").
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Answer generation: OpenAI by default, using OPENAI_API_KEY. For a local
# OpenAI-compatible server such as Ollama, set LLM_BASE_URL (e.g.
# "http://localhost:11434/v1") and a model it serves. An empty
# LLM_TEMPERATURE uses the model's default.
LLM_BASE_URL=""
LLM_MODEL="gpt-4.1-mini"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=""
# Token usage of streamed answers; set to false if your server rejects stream_options.
LLM_STREAM_USAGE=true
# The model's prices in US dollars per million tokens, for answer costs.
# Empty means unknown; use 0 for a free tier.
LLM_INPUT_PRICE_PER_MILLION=""
LLM_OUTPUT_PRICE_PER_MILLION=""
# Chunks scoring below this are not used for answers.
ANSWER_MIN_SCORE=0.3

# Ports on this computer for docker compose; change one when it is already in use.
# WEB_PORT=3000
# API_PORT=8000
# DB_PORT=5432

# Matches compose.yaml
DATABASE_URL="postgresql+asyncpg://mini_rag:mini_rag@localhost:5432/mini_rag"

FILES_DIR="assets/files"
FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB
