# Rendered at container start: ${API_UPSTREAM} and ${NGINX_RESOLVER} come
# from the environment (see the Dockerfile).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Resolve the API's name at request time, so a restarted API container
    # with a new address is still found.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api ${API_UPSTREAM};

    # The API enforces its own upload limit (FILE_MAX_SIZE).
    client_max_body_size 100m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/(api/|docs(/|$)|openapi\.json$) {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Answers stream as Server-Sent Events: pass each event on at once.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Built files have content hashes in their names: cache them for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Every other path is a page of the app.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
